# MOD-001 Ingestion live-test configuration.
#
# Copy this file to `.env` (same dir) and fill in your real values:
#   cp .env.example .env
#
# `.env` is git-ignored. The test loader reads this file automatically and
# only sets a key when the shell env does NOT already define it (so CI overrides
# stay authoritative). Variables follow SPEC-001 § Unknowns + DESIGN.md
# Implementation Handoff requirements.

# ─── Live RPC endpoint ────────────────────────────────────────────────────────
# Public Robinhood Chain RPC URL. Used by test_v4_contract_addresses.py,
# test_known_pool.py, and any future live verification.
# Find at: https://docs.robinhood.com (developer / chain docs).
MOD_001_LIVE_RPC_URL=

# ─── Known-pool fetch fixture (REQ-001 live verification) ─────────────────────
# Pool address used by test_known_pool.py and the REQ-001 cross-check.
# Must be a V4 pool that has emitted Initialize + at least one Swap /
# ModifyLiquidity in the window below.
MOD_001_TEST_POOL=

# Inclusive lower / upper block bounds for the known-pool fetch. Pick a window
# with documented events (visible on Robinhood Chain explorer or Bitquery).
MOD_001_TEST_START_BLOCK=
MOD_001_TEST_END_BLOCK=

# ─── Ground-truth fixtures (optional, path-relative) ─────────────────────────
# Path to the explorer / Bitquery event-list export used as the REQ-001
# independent source. JSON list of {block_number, log_index, tx_hash,
# event_type}. Leave blank to skip the live cross-check test.
MOD_001_KNOWN_EVENTS_FILE=

# Path to the N >= 10 block reconstruction ground truth. JSON list of
# {block_number, expected_sqrt_price_x96, expected_tick, expected_liquidity}.
# Leave blank to skip REQ-002 sampling.
MOD_001_RECONSTRUCTION_GROUND_TRUTH_FILE=